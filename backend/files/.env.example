# FeedMe Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

PORT=5000

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=feedme_db

# JWT Secret (change this to a long random string)
JWT_SECRET=feedme_super_secret_jwt_key_change_this_in_production

# AWS S3 (fill in after AWS setup)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_BUCKET_NAME=feedme-uploads
AWS_REGION=ap-southeast-2
